# LLM Configuration (OpenAI / Cloud Providers)
MODEL=gpt-4o
OPENAI_API_KEY=your_openai_api_key_here

# Local Ollama Host Configuration (Optional - defaults to http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Web Search Provider Keys (At least one recommended for web fallback)
SERPER_API_KEY=your_serper_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Vector Storage Configuration (Optional - defaults to ./data/qdrant_db)
QDRANT_STORAGE_PATH=./data/qdrant_db